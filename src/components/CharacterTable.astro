---
import '../styles/global.css';
import subsetFontUrl from '../assets/fonts/genshin-subset.woff2?url';
import characters from '../data/characters';
import { createRows, imageUrl } from '../lib/characters';
const rows = createRows(characters);
const url = (path: string) => imageUrl(path, import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={subsetFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={url('/images/favicon.png')} />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try {
        document.documentElement.classList.toggle(
          'dark',
          localStorage.getItem('theme') !== 'light',
        );
      } catch {
        document.documentElement.classList.add('dark');
      }
    </script>
    <meta name="description" content="按属性与命途类型查看绝区零角色分布" />
    <title>绝区零角色分布</title>
    <meta name="google-site-verification" content="tXyJhIUjwgDkdY4scPFF1nBiVW9co3-HjowXazdoL7I" />
    <meta name="msvalidate.01" content="900BFBEC9CA24BE1B56B696EF1CE3B2E" />
  </head>
  <body>
    <header id="banner" class="bar">
      <span class="text-base font-semibold tracking-tight">
        绝区零角色分布 （截止至{characters.version}）
      </span>
      <button id="theme-toggle" type="button" aria-pressed="true">
        <span class="light-icon" aria-hidden="true">
          ☀
        </span>
        <span class="dark-icon" aria-hidden="true">
          ☾
        </span>
      </button>
      <a
        href="https://github.com/AruDashboard/ZZZCharacterDistribution/issues"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-500 hover:text-sky-600 dark:text-slate-400 dark:hover:text-sky-400"
      >
        报错 ↗
      </a>
    </header>
    <main id="wrap" tabindex="0">
      <table id="t">
        <thead>
          <tr>
            <th scope="col">
              <span>属性 \ 特性</span>
            </th>
            {characters.cols.map((col) => (
              <th scope="col">
                <div class="flex items-center justify-center gap-1.5">
                  <img
                    src={url('/images/specialties/' + col.image)}
                    alt={col.key}
                    class="object-contain"
                  />
                  <span class="whitespace-nowrap">{col.key}</span>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">
                {row.elements.map((element) => (
                  <div class="flex items-center justify-center gap-4">
                    <img
                      src={url('/images/elements/' + element.image)}
                      alt={element.key}
                      class="object-contain"
                    />
                    <span class="whitespace-nowrap">{element.key}</span>
                  </div>
                ))}
              </th>
              {row.cells.map((cell) => (
                <td>
                  <div class="imgs">
                    {cell.map((character) => (
                      <img
                        src={url('/images/characters/' + character.image)}
                        alt={character.name}
                        data-tip={character.name}
                        data-rank={character.rank}
                        tabindex="0"
                      />
                    ))}
                  </div>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </main>
    <footer id="footer" class="bar">
      <span id="msg" role="status" aria-live="polite"></span>
      <div class="flex items-center">
        <input
          checked
          id="show-rank-4"
          type="checkbox"
          value="4"
          class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft"
        />
        <label for="show-rank-4" class="select-none ms-2 text-base font-medium text-heading">
          显示A级
        </label>
      </div>
      <div class="flex items-center">
        <input
          checked
          id="show-rank-5"
          type="checkbox"
          value="5"
          class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft"
        />
        <label for="show-rank-5" class="select-none ms-2 text-base font-medium text-heading">
          显示S级
        </label>
      </div>
    </footer>
    <div id="tip" role="tooltip"></div>
    <script src="../scripts/table.ts"></script>
    <script src="../scripts/theme.ts"></script>
    <script async src="https://googletagmanager.com" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-7SJX08ZFSV');
    </script>
  </body>
</html>
